{{!-- Rippers character sheet — "Vin" 2a "The Slash" (SOURCE-vin-sheet-2a.dc.html board 2a).
      P2a: skin reconciled to 2a + core play loop wired (vitals steppers, status buttons self/target,
      guise swap). Data bindings from buildRippersSheetVM (real actor.system.*). --}}
<div class="rippers-sheet">
	<div class="rs-frame">
		<div class="rs-slash-red"></div><div class="rs-slash-dark"></div>
		<div class="rs-grain"></div><div class="rs-watermark">{{vm.masthead.initial}}</div>

		<div class="rs-titlebar">
			<span class="rs-tb-name">{{localize 'RIPPERS.Sheet.TitleBar'}}</span>
			<span class="rs-tb-name">{{vm.masthead.level}} · {{#if vm.worn}}{{localize 'RIPPERS.Sheet.Worn'}}{{else}}{{localize 'RIPPERS.Sheet.Unmasked'}}{{/if}}</span>
		</div>

		{{!-- ── Masthead ─────────────────────────────────────────── --}}
		<div class="rs-head">
			<div class="rs-portrait"><div class="rs-portrait-inner">{{#if actor.img}}<img src="{{actor.img}}" alt="" />{{/if}}</div></div>

			<div class="rs-idcol">
				<div>
					<h1 class="rs-name">{{vm.masthead.name}}</h1>
					{{#if vm.masthead.role}}<div class="rs-role">{{vm.masthead.role}}</div>{{/if}}
				</div>

				<div class="rs-stats">
					{{!-- HP (bar + temporary lent overlay; number in parens per X1) --}}
					<span class="rs-stat rs-stat-hp {{#if vm.vitals.crisis.inCrisis}}rs-stat-crisis-on{{/if}}">
						<span class="rs-stat-label">HP</span>
						<span class="rs-stat-num">{{vm.vitals.hp.bar.value}}{{#if vm.vitals.hp.bar.lent}} <span class="rs-lent-num">(+{{vm.vitals.hp.bar.lent}})</span>{{/if}} / {{vm.vitals.hp.max}}</span>
						<span class="rs-bar rs-bar-hp"><span class="rs-bar-fill" style="width:{{vm.vitals.hp.bar.basePct}}%"></span>{{#if vm.vitals.hp.bar.lent}}<span class="rs-bar-lent" style="width:{{vm.vitals.hp.bar.lentPct}}%"></span>{{/if}}</span>
						<span class="rs-stat-sub">{{localize 'RIPPERS.Sheet.Crisis'}} {{vm.vitals.crisis.score}}</span>
						<span class="rs-step"><button data-action="resAdjust" data-res="hp" data-dir="-1" title="{{localize 'RIPPERS.Sheet.Damage'}}">&minus;</button><button data-action="resAdjust" data-res="hp" data-dir="1" title="{{localize 'RIPPERS.Sheet.Heal'}}">+</button></span>
					</span>
					{{!-- MP (bar + temporary lent overlay) --}}
					<span class="rs-stat rs-stat-mp">
						<span class="rs-stat-label">MP</span>
						<span class="rs-stat-num">{{vm.vitals.mp.bar.value}}{{#if vm.vitals.mp.bar.lent}} <span class="rs-lent-num">(+{{vm.vitals.mp.bar.lent}})</span>{{/if}} / {{vm.vitals.mp.max}}</span>
						<span class="rs-bar rs-bar-mp"><span class="rs-bar-fill" style="width:{{vm.vitals.mp.bar.basePct}}%"></span>{{#if vm.vitals.mp.bar.lent}}<span class="rs-bar-lent" style="width:{{vm.vitals.mp.bar.lentPct}}%"></span>{{/if}}</span>
						<span class="rs-step"><button data-action="resAdjust" data-res="mp" data-dir="-1">&minus;</button><button data-action="resAdjust" data-res="mp" data-dir="1">+</button></span>
					</span>
					{{!-- DEF / MDEF --}}
					<span class="rs-stat rs-stat-small rs-stat-dual">
						<span class="rs-dv"><span class="rs-stat-label">DEF</span><span class="rs-stat-num">{{vm.derived.def}}</span></span>
						<span class="rs-dv"><span class="rs-stat-label">M.DEF</span><span class="rs-stat-num">{{vm.derived.mdef}}</span></span>
					</span>
					{{!-- Fabula --}}
					<span class="rs-stat rs-stat-small">
						<span class="rs-stat-label">{{localize 'RIPPERS.Sheet.Fabula'}}</span>
						<span class="rs-stat-num">{{vm.vitals.fp}}</span>
						<span class="rs-step"><button data-action="spendFabula" title="{{localize 'RIPPERS.Sheet.SpendFabula'}}">{{localize 'RIPPERS.Sheet.Spend'}}</button></span>
					</span>
					{{!-- IP (dots per H5; temporary lent dots + parens number) --}}
					<span class="rs-stat rs-stat-small">
						<span class="rs-stat-label">IP</span>
						<span class="rs-stat-num">{{vm.vitals.ip.dots.value}}{{#if vm.vitals.ip.dots.lent}} <span class="rs-lent-num">(+{{vm.vitals.ip.dots.lent}})</span>{{/if}} / {{vm.vitals.ip.max}}</span>
						<span class="rs-ipdots">{{#each vm.vitals.ip.dots.dots as |d|}}<span class="rs-ipdot{{#if d.filled}} filled{{/if}}"></span>{{/each}}{{#each vm.vitals.ip.dots.lentDots as |d|}}<span class="rs-ipdot temp"></span>{{/each}}</span>
						<span class="rs-step"><button data-action="resAdjust" data-res="ip" data-dir="-1">&minus;</button><button data-action="resAdjust" data-res="ip" data-dir="1">+</button></span>
					</span>
				</div>

				<div class="rs-attrline">
					{{localize 'RIPPERS.Sheet.Level'}} <b>{{vm.masthead.level}}</b>
					{{#each vm.attributes as |a|}} &nbsp;·&nbsp; {{a.label}} <b>{{a.die}}</b>{{/each}}
				</div>
				{{#if vm.masthead.classes.length}}<div><span class="rs-torment">{{#each vm.masthead.classes as |c|}}{{c}} {{/each}}</span></div>{{/if}}
				<div class="rs-floor-row">
					<button class="rs-chip" data-action="rollCheck">{{localize 'RIPPERS.Sheet.RollCheck'}}</button>
					<button class="rs-chip" data-action="rest">{{localize 'RIPPERS.Sheet.Rest'}}</button>
					<button class="rs-chip" data-action="healToCrisis" title="{{localize 'RIPPERS.Sheet.HealToCrisisHint'}}">{{localize 'RIPPERS.Sheet.HealToCrisis'}}</button>
					{{!-- R1: the Rival cost-waiver roller toggle — shown only if the actor has the Rival quirk. --}}
					{{#if vm.rivalWaiver.has}}<button class="rs-chip{{#if vm.rivalWaiver.armed}} rs-chip-on{{/if}}" data-action="toggleRivalWaiver" title="{{localize 'RIPPERS.Sheet.RivalWaiverHint'}}">{{localize 'RIPPERS.Sheet.RivalWaiver'}}</button>{{/if}}
					{{!-- H2: manual face toggle (normal ↔ other-shape) — shown only when a face is configured. --}}
					{{#if vm.faces.canToggle}}<button class="rs-chip{{#if vm.faces.onOther}} rs-chip-on{{/if}}" data-action="toggleFace" title="{{localize 'RIPPERS.Sheet.ToggleFaceHint'}}">{{localize 'RIPPERS.Sheet.OtherShape'}}</button>{{/if}}
				</div>
			</div>

			{{!-- Swap column --}}
			<div class="rs-swapcol">
				<button class="rs-swap-btn" data-action="guiseSwap" title="{{localize 'RIPPERS.Sheet.SwapHint'}}"><span>{{localize 'RIPPERS.Sheet.Swap'}}</span></button>
				{{#if vm.guises.length}}
					<div class="rs-guise-picker">
						{{#each vm.guises as |g|}}
							<button class="rs-guise-pick {{#if g.worn}}rs-worn{{/if}}" data-action="guiseWear" data-guise="{{g.id}}">
								<span>{{g.name}}</span>
								<span class="rs-gp-marker">{{#if g.worn}}{{localize 'RIPPERS.Sheet.Worn'}}{{else if g.innate}}{{localize 'RIPPERS.Sheet.Innate'}}{{else}}{{localize 'RIPPERS.Sheet.Tradable'}}{{/if}}</span>
							</button>
						{{/each}}
					</div>
				{{/if}}
				{{!-- H1: worn-guise indicator = violet tag showing the guise's NAME --}}
				<div class="rs-worn-tag {{#if vm.worn}}rs-worn-violet{{/if}}">{{#if vm.worn}}{{vm.wornName}}{{else}}{{localize 'RIPPERS.Sheet.Unmasked'}}{{/if}}</div>
			</div>
		</div>

		{{!-- ── Tab slash row ────────────────────────────────────── --}}
		<div class="rs-tabs">
			{{#each vm.tabs as |t|}}
				<button class="rs-tab {{#if t.active}}rs-tab-active{{/if}}" data-action="selectTab" data-tab="{{t.key}}"><span>{{t.label}}</span></button>
			{{/each}}
		</div>

		{{!-- ── Tab body ─────────────────────────────────────────── --}}
		<div class="rs-tbody">
			{{#if vm.tab.form}}
				{{!-- H2: the two configurable faces (NORMAL + OTHER-SHAPE). A worn guise assigns one below. --}}
				<div class="rs-faces">
					<span class="rs-faces-label">{{localize 'RIPPERS.Sheet.Faces'}}</span>
					<button class="rs-chip" data-action="setFace" data-face="normal">{{localize 'RIPPERS.Sheet.FaceNormal'}}{{#if vm.faces.normal}} ✓{{/if}}</button>
					<button class="rs-chip" data-action="setFace" data-face="other">{{localize 'RIPPERS.Sheet.FaceOther'}}{{#if vm.faces.other}} ✓{{/if}}</button>
				</div>
				{{#if vm.guises.length}}
					{{#each vm.guises as |g|}}
						<div class="rs-classcard">
							<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
								<span style="display:flex;align-items:center;gap:10px;">
									{{!-- 2a: the guise-identity tarot tile — click to pick from the 22 major arcana. --}}
									<button class="rs-arcana-tile{{#if g.arcana}} has-art{{/if}}" data-action="pickArcana" data-guise="{{g.id}}" title="{{#if g.arcana}}{{g.arcana.name}}{{else}}{{localize 'RIPPERS.Sheet.PickArcana'}}{{/if}}">{{#if g.arcana}}<img src="{{g.arcana.img}}" alt="{{g.arcana.name}}">{{else}}<span class="rs-arcana-empty">★</span>{{/if}}</button>
									<span class="rs-classcard-name">{{g.name}}</span>
								</span>
								<span class="rs-bond-strength">{{#if g.worn}}{{localize 'RIPPERS.Sheet.Worn'}}{{else if g.innate}}{{localize 'RIPPERS.Sheet.Innate'}}{{else}}{{localize 'RIPPERS.Sheet.Tradable'}}{{/if}}</span>
							</div>
							{{#if g.trio.length}}<div class="rs-affchips" style="margin-top:8px;">{{#each g.trio as |t|}}<span class="rs-affchip {{#if t.good}}rs-aff-good{{/if}}{{#if t.bad}}rs-aff-bad{{/if}}">{{t.word}} {{t.type}}</span>{{/each}}</div>{{/if}}
							<div class="rs-skillrow"><span>{{localize 'RIPPERS.Sheet.Skills'}}</span><b>{{g.skillCount}} · {{g.slTotal}}/{{g.budget}} SL</b>
								<button class="rs-chip{{#if g.slEditable}} rs-chip-on{{/if}}" data-action="toggleSlLock" data-guise="{{g.id}}" title="{{localize 'RIPPERS.Sheet.SlUnlockHint'}}">{{localize 'RIPPERS.Sheet.SlUnlock'}}</button>
							</div>
							{{#if g.slEditable}}
								{{#each g.skillGroups as |grp|}}
									<div class="rs-skilledit">
										<div class="rs-skilledit-class">{{grp.className}}</div>
										{{#each grp.skills as |s|}}
											<div class="rs-skilledit-row">
												<span class="rs-skilledit-name">{{s.name}}</span>
												<span class="rs-step">
													<button data-action="skillSlAdjust" data-guise="{{g.id}}" data-class="{{s.classUuid}}" data-skill="{{s.skillUuid}}" data-dir="-1">&minus;</button>
													<b class="rs-skilledit-sl">{{s.sl}}<span class="rs-skilledit-max">/{{s.maxSl}}</span></b>
													<button data-action="skillSlAdjust" data-guise="{{g.id}}" data-class="{{s.classUuid}}" data-skill="{{s.skillUuid}}" data-dir="1">+</button>
												</span>
											</div>
										{{/each}}
									</div>
								{{/each}}
							{{/if}}
							{{#if g.heroicName}}<div class="rs-heroic" style="margin-top:8px;"><span class="rs-heroic-label">{{localize 'RIPPERS.Sheet.Heroic'}}</span><span class="rs-heroic-name">{{g.heroicName}}</span></div>{{/if}}
							{{!-- H2: which face this guise shows when worn (normal / other-shape / no-portrait well). --}}
							<div class="rs-faceassign"><span>{{localize 'RIPPERS.Sheet.ShowsFace'}}</span>
								<button class="rs-chip{{#if g.faceNormal}} rs-chip-on{{/if}}" data-action="setGuiseFace" data-guise="{{g.id}}" data-value="normal">{{localize 'RIPPERS.Sheet.FaceNormal'}}</button>
								<button class="rs-chip{{#if g.faceOther}} rs-chip-on{{/if}}" data-action="setGuiseFace" data-guise="{{g.id}}" data-value="other">{{localize 'RIPPERS.Sheet.FaceOther'}}</button>
								<button class="rs-chip{{#if g.faceNone}} rs-chip-on{{/if}}" data-action="setGuiseFace" data-guise="{{g.id}}" data-value="none">{{localize 'RIPPERS.Sheet.FaceNone'}}</button>
							</div>
							<div class="rs-skillrow">
								<span>
									{{#if g.lent.hp.maximum}}{{localize 'RIPPERS.Sheet.LentHP'}} {{g.lent.hp.current}}/{{g.lent.hp.maximum}} &nbsp;{{/if}}
									{{#if g.lent.mp.maximum}}{{localize 'RIPPERS.Sheet.LentMP'}} {{g.lent.mp.current}}/{{g.lent.mp.maximum}} &nbsp;{{/if}}
									{{#if g.lent.ip.capacity}}{{localize 'RIPPERS.Sheet.Satchel'}} {{g.lent.ip.stock}}/{{g.lent.ip.capacity}}{{/if}}
								</span>
								<span>
									{{#if g.worn}}<button class="rs-chip" data-action="guiseWear" data-guise="{{g.id}}">{{localize 'RIPPERS.Sheet.Unmask'}}</button>{{else}}<button class="rs-chip" data-action="guiseWear" data-guise="{{g.id}}">{{localize 'RIPPERS.Sheet.Wear'}}</button>{{/if}}
									{{#if g.worn}}<button class="rs-chip" data-action="stashGuise" data-guise="{{g.id}}">{{localize 'RIPPERS.Sheet.Stash'}}</button>{{/if}}
									{{#if g.tradable}}<button class="rs-chip" data-action="handOffGuise" data-guise="{{g.id}}">{{localize 'RIPPERS.Sheet.HandOff'}}</button>{{else}}<span class="rs-tag-bound">{{localize 'RIPPERS.Sheet.Untradable'}}</span>{{/if}}
								</span>
							</div>
						</div>
					{{/each}}
				{{else}}
					<p class="rs-empty">{{localize 'RIPPERS.Sheet.NoGuises'}}</p>
				{{/if}}
				<div class="rs-affchips">
					{{#each vm.affinities as |aff|}}{{#unless aff.normal}}<span class="rs-affchip {{#if aff.good}}rs-aff-good{{/if}}{{#if aff.bad}}rs-aff-bad{{/if}}">{{aff.type}} — {{aff.word}}</span>{{/unless}}{{/each}}
				</div>
			{{/if}}

			{{#if vm.tab.bonds}}
				{{#if vm.bondsNative}}
					{{#if vm.bondsIsGM}}
						<div class="rs-bond-section-controls">
							<button type="button" class="rs-btn rdb-btn" data-action="bondCreate">＋ {{localize 'RIPPERS.Sheet.BondNew'}}</button>
							<button type="button" class="rs-btn rdb-btn" data-action="bondSolidifyRest">{{localize 'RIPPERS.Sheet.BondSolidifyRest'}}</button>
						</div>
					{{/if}}
					{{#if vm.bonds.length}}
						<div class="rs-bondgrid">
							{{#each vm.bonds as |b|}}
								<div class="rs-bondcard rdb-bar rdb-tier-{{b.tier}}">
									<span class="rs-bond-name">{{b.name}}</span>
									<span class="rs-bond-tier rdb-tier-tag">{{b.tier}}</span>
									<span class="rs-bond-strength">{{localize 'RIPPERS.Sheet.Strength'}} {{b.strength}}</span>
									<span class="rs-emos">{{#each b.emotions as |e|}}<span class="rs-emo">{{e}}</span>{{/each}}</span>
									{{#if b.showClock}}
										<span class="rs-bond-clock rdb-clock">{{#each b.clockPips as |p|}}<span class="rs-pip rdb-clock-pip{{#if p.filled}} filled{{/if}}"></span>{{/each}}</span>
									{{/if}}
									{{#if b.grantedSkill}}<span class="rs-bond-skill">✦ {{b.grantedSkill}}</span>{{/if}}
									{{#if ../vm.bondsIsGM}}
										<span class="rs-bond-controls">
											{{#if b.solidifyShow}}<button type="button" class="rs-btn rdb-btn" data-action="bondSolidify" data-bond="{{b.name}}" {{#if b.solidifyDisabled}}disabled title="{{localize 'RIPPERS.Sheet.BondCapReached'}}"{{/if}}>{{localize 'RIPPERS.Sheet.BondSolidify'}}</button>{{/if}}
											{{#if b.canEternal}}<button type="button" class="rs-btn rdb-btn" data-action="bondEternal" data-bond="{{b.name}}">{{localize 'RIPPERS.Sheet.BondEternal'}}</button>{{/if}}
											{{#if b.showClock}}<button type="button" class="rs-btn rdb-btn" data-action="bondClockFill" data-bond="{{b.name}}">{{localize 'RIPPERS.Sheet.BondClockFill'}}</button>{{/if}}
											{{#if b.ladder.cleanse}}<button type="button" class="rs-btn rdb-btn" data-action="bondCleanse" data-bond="{{b.name}}">{{localize 'RIPPERS.Sheet.BondCleanse'}}</button>{{/if}}
											{{#if b.ladder.coverRegen}}<button type="button" class="rs-btn rdb-btn" data-action="bondCoverRegen" data-bond="{{b.name}}">{{localize 'RIPPERS.Sheet.BondCoverRegen'}}</button>{{/if}}
											{{#if b.ladder.attrDieUp}}<button type="button" class="rs-btn rdb-btn" data-action="bondRaiseDie" data-bond="{{b.name}}">{{localize 'RIPPERS.Sheet.BondRaiseDie'}}</button>{{/if}}
											{{#if b.ladder.skillGrant}}<button type="button" class="rs-btn rdb-btn" data-action="bondSkillGrant" data-bond="{{b.name}}">{{localize 'RIPPERS.Sheet.BondSkillGrant'}}</button>{{/if}}
										</span>
									{{/if}}
								</div>
							{{/each}}
						</div>
					{{else}}<p class="rs-empty">{{localize 'RIPPERS.Sheet.NoBonds'}}</p>{{/if}}
				{{else}}
					{{#if vm.bonds.length}}
						<div class="rs-bondgrid">
							{{#each vm.bonds as |b|}}
								<div class="rs-bondcard">
									<span class="rs-bond-name">{{b.name}}</span>
									<span class="rs-bond-strength">{{localize 'RIPPERS.Sheet.Strength'}} {{b.strength}}</span>
									<span class="rs-emos">{{#each b.emotions as |e|}}<span class="rs-emo">{{e}}</span>{{/each}}</span>
								</div>
							{{/each}}
						</div>
					{{else}}<p class="rs-empty">{{localize 'RIPPERS.Sheet.NoBonds'}}</p>{{/if}}
				{{/if}}
			{{/if}}

			{{#if vm.tab.study}}
				{{!-- Item 3: the character's own identity fields are editable inline (name + FU identity slots).
				      Guise fields stay fixed-at-distillation (that lock is separate, on the Edit tab). --}}
				<div class="rs-study">
					<span class="rs-study-label">{{localize 'RIPPERS.Sheet.Name'}}</span><input class="rs-study-input" type="text" data-idfield="name" value="{{vm.masthead.name}}">
					<span class="rs-study-label">{{localize 'RIPPERS.Sheet.Identity'}}</span><input class="rs-study-input" type="text" data-idfield="identity" value="{{vm.masthead.identity}}">
					<span class="rs-study-label">{{localize 'RIPPERS.Sheet.Theme'}}</span><input class="rs-study-input" type="text" data-idfield="theme" value="{{vm.masthead.theme}}">
					<span class="rs-study-label">{{localize 'RIPPERS.Sheet.Origin'}}</span><input class="rs-study-input" type="text" data-idfield="origin" value="{{vm.masthead.origin}}">
					<span class="rs-study-label">{{localize 'RIPPERS.Sheet.Pronouns'}}</span><input class="rs-study-input" type="text" data-idfield="pronouns" value="{{vm.masthead.pronouns}}">
				</div>
			{{/if}}

			{{#if vm.tab.quirk}}
				{{!-- Item 3: manage the character's quirks (FU 'effect' Items) — add / edit / remove. --}}
				<div class="rs-quirks">
					{{#if vm.quirks.length}}
						{{#each vm.quirks as |q|}}
							<div class="rs-classcard rs-quirk-row" style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
								<span class="rs-classcard-name">{{q.name}}</span>
								<span class="rs-quirk-ctl">
									<button class="rs-chip" data-action="quirkEdit" data-item="{{q.id}}">{{localize 'RIPPERS.Sheet.QuirkEdit'}}</button>
									<button class="rs-chip" data-action="quirkRemove" data-item="{{q.id}}" title="{{localize 'RIPPERS.Sheet.QuirkRemove'}}">✕</button>
								</span>
							</div>
						{{/each}}
					{{else}}<p class="rs-empty">{{localize 'RIPPERS.Sheet.NoQuirks'}}</p>{{/if}}
					<div class="rs-res-controls"><button class="rs-btn" data-action="quirkAdd">＋ {{localize 'RIPPERS.Sheet.QuirkAdd'}}</button></div>
				</div>
			{{/if}}

			{{#if vm.tab.resources}}
				{{!-- G4: Reputation + class-specific resources (Brainwave, Combo Points, …) — a generic tracker;
				      these have no FU data model, so they're per-actor tracked counters (add by name). --}}
				<div class="rs-res-tab">
					{{#if vm.trackedResources.length}}
						<div class="rs-resgrid">
							{{#each vm.trackedResources as |r|}}
								<div class="rs-rescard">
									<span class="rs-res-name">{{r.label}}</span>
									<span class="rs-res-num">{{r.value}}{{#if r.max}} / {{r.max}}{{/if}}</span>
									<span class="rs-step">
										<button data-action="resTrackAdjust" data-key="{{r.key}}" data-dir="-1">&minus;</button>
										<button data-action="resTrackAdjust" data-key="{{r.key}}" data-dir="1">+</button>
										<button data-action="resTrackRemove" data-key="{{r.key}}" title="{{localize 'RIPPERS.Sheet.ResRemove'}}">✕</button>
									</span>
								</div>
							{{/each}}
						</div>
					{{else}}<p class="rs-empty">{{localize 'RIPPERS.Sheet.ResEmpty'}}</p>{{/if}}
					<div class="rs-res-controls"><button class="rs-btn" data-action="resTrackAdd">＋ {{localize 'RIPPERS.Sheet.ResAdd'}}</button></div>
				</div>
			{{/if}}

			{{#if vm.tab.vault}}
				{{!-- V3: Party Vault embedded tab. Each member's FIELD shows one card per guise + dashed
				      empty slots up to the limit (party size + 2, V1 display-only). The CABINET is the
				      compendium pack (V4). Drag a guise card onto another member's field to trade (X4,
				      GM-brokered), or onto the cabinet to stash; drag a cabinet entry onto a field to
				      slot. Layout is intentionally thin — Austin owns the visual design. --}}
				<div class="rs-vault">
					<div class="rs-vault-note">{{localize 'RIPPERS.Vault.Field'}} limit {{vm.vault.fieldLimit}} (party {{vm.vault.partySize}} + 2)</div>
					{{#each vm.vault.members as |m|}}
						<div class="rs-vault-member" data-vault-drop="field" data-actor="{{m.actorId}}">
							<div class="rs-vault-mhead">
								<img class="rs-vault-portrait" src="{{m.img}}" alt="">
								<span class="rs-vault-mname">{{m.name}}</span>
								{{#if m.worn}}<span class="rs-worn-violet">{{m.worn}}</span>{{/if}}
								<span class="rs-vault-count {{#if m.overLimit}}rs-vault-over{{/if}}">{{m.count}} / {{m.limit}}</span>
							</div>
							<div class="rs-vault-field">
								{{#each m.slots as |s|}}
									{{#if s.filled}}
										<div class="rs-vault-card {{#if s.guise.worn}}rs-vault-worn{{/if}} {{#if s.guise.innate}}rs-vault-innate{{/if}}"
										     draggable="{{#if s.guise.tradable}}true{{else}}false{{/if}}"
										     data-vault-guise="{{s.guise.id}}" data-actor="{{m.actorId}}" data-uuid="{{s.guise.uuid}}">
											<img src="{{s.guise.img}}" alt="">
											<span class="rs-vault-cname">{{s.guise.name}}</span>
											{{#if s.guise.lent.hp.current}}<span class="rs-vault-lent">HP (+{{s.guise.lent.hp.current}})</span>{{/if}}
											{{#if s.guise.lent.mp.current}}<span class="rs-vault-lent">MP (+{{s.guise.lent.mp.current}})</span>{{/if}}
											{{#if m.canWrite}}<button class="rs-vault-x" data-action="vaultStash" data-guise="{{s.guise.id}}" data-actor="{{m.actorId}}" title="{{localize 'RIPPERS.Vault.Cabinet'}}">▾</button>{{/if}}
										</div>
									{{else}}
										<div class="rs-vault-slot" title="{{localize 'RIPPERS.Vault.Empty'}}"></div>
									{{/if}}
								{{/each}}
							</div>
						</div>
					{{/each}}
					<div class="rs-vault-cabinet" data-vault-drop="cabinet">
						<div class="rs-vault-mhead"><span class="rs-vault-mname">{{vm.vault.cabinet.label}}</span></div>
						{{#if vm.vault.cabinet.entries.length}}
							<div class="rs-vault-field">
								{{#each vm.vault.cabinet.entries as |e|}}
									<div class="rs-vault-card" draggable="true" data-vault-cabinet="{{e.uuid}}" data-uuid="{{e.uuid}}">
										<img src="{{e.img}}" alt="">
										<span class="rs-vault-cname">{{e.name}}</span>
									</div>
								{{/each}}
							</div>
						{{else}}<p class="rs-empty">{{#if vm.vault.cabinet.missing}}Cabinet compendium not found.{{else}}The cabinet is empty.{{/if}}</p>{{/if}}
					</div>
				</div>
			{{/if}}

			{{#if vm.tab.kit}}
				{{#if vm.weapons.length}}
					{{#each vm.weapons as |w|}}
						<div class="rs-classcard rs-weapon-row">
							<div class="rs-weapon-head">
								<input class="rs-weapon-name" type="text" data-item="{{w.id}}" data-item-edit="name" value="{{w.name}}">
								<span>
									<button class="rs-chip" data-action="rollWeapon" data-item="{{w.id}}">{{localize 'RIPPERS.Sheet.Attack'}}</button>
									<button class="rs-chip" data-action="itemSheet" data-item="{{w.id}}" title="{{localize 'RIPPERS.Sheet.OpenItem'}}">⚙</button>
								</span>
							</div>
							{{!-- Inline-editable common fields; the ⚙ opens the full item sheet for the rest. --}}
							<div class="rs-weapon-edit">
								<label class="rs-wedit"><span>ACC</span>
									<select data-item="{{w.id}}" data-item-edit="{{w.edit.paths.primary}}">{{#each w.edit.primaryOpts as |o|}}<option value="{{o.v}}" {{#if o.sel}}selected{{/if}}>{{o.v}}</option>{{/each}}</select>
									<select data-item="{{w.id}}" data-item-edit="{{w.edit.paths.secondary}}">{{#each w.edit.secondaryOpts as |o|}}<option value="{{o.v}}" {{#if o.sel}}selected{{/if}}>{{o.v}}</option>{{/each}}</select>
									<input type="number" data-item="{{w.id}}" data-item-edit="{{w.edit.paths.accuracy}}" data-dtype="number" value="{{w.accBonus}}" title="{{localize 'RIPPERS.Sheet.AccBonus'}}">
								</label>
								<label class="rs-wedit"><span>DMG</span>
									<span class="rs-wedit-hr">HR +</span>
									<input type="number" data-item="{{w.id}}" data-item-edit="{{w.edit.paths.damage}}" data-dtype="number" value="{{w.dmgBonus}}">
									<select data-item="{{w.id}}" data-item-edit="{{w.edit.paths.damageType}}">{{#each w.edit.dtypeOpts as |o|}}<option value="{{o.v}}" {{#if o.sel}}selected{{/if}}>{{o.v}}</option>{{/each}}</select>
								</label>
								<label class="rs-wedit"><span>{{localize 'RIPPERS.Sheet.WeaponType'}}</span>
									<select data-item="{{w.id}}" data-item-edit="{{w.edit.paths.wtype}}">{{#each w.edit.wtypeOpts as |o|}}<option value="{{o.v}}" {{#if o.sel}}selected{{/if}}>{{o.v}}</option>{{/each}}</select>
								</label>
								{{#if w.traits.length}}<div class="rs-weapon-traits">{{#each w.traits as |t|}}<span class="rs-wtag">{{t}}</span>{{/each}}</div>{{/if}}
							</div>
						</div>
					{{/each}}
				{{else}}<p class="rs-empty">{{localize 'RIPPERS.Sheet.NoWeapons'}}</p>{{/if}}
				{{!-- v0.7.15: full inventory — armor/shields/accessories/consumables/treasures (native FU items) --}}
				<div class="rs-inv-head">
					<span class="rs-edit-title">{{localize 'RIPPERS.Sheet.Inventory'}}</span>
					<label class="rs-inv-useeq"><input type="checkbox" data-action="toggleUseEquipment" {{#if vm.inventory.useEquipment}}checked{{/if}}> {{localize 'RIPPERS.Sheet.UseEquipment'}}</label>
				</div>
				{{#each vm.inventory.sections as |sec|}}
					{{#if sec.any}}
						<div class="rs-inv-section">
							<div class="rs-inv-label">{{sec.label}}</div>
							{{#each sec.items as |it|}}
								<div class="rs-inv-row{{#if it.equipped}} rs-inv-equipped{{/if}}">
									<img class="rs-inv-img" src="{{it.img}}" alt="">
									<span class="rs-inv-name">{{it.name}}</span>
									<span class="rs-inv-stats">{{#each it.fields as |f|}}<span class="rs-inv-stat">{{f.label}} {{f.val}}</span>{{/each}}</span>
									<span class="rs-inv-controls">
										{{#if it.equippable}}<button type="button" class="rs-chip" data-action="itemEquip" data-item="{{it.id}}">{{#if it.equipped}}{{localize 'RIPPERS.Sheet.Unequip'}}{{else}}{{localize 'RIPPERS.Sheet.Equip'}}{{/if}}</button>{{/if}}
										{{#if it.usable}}<button type="button" class="rs-chip" data-action="itemUse" data-item="{{it.id}}">{{localize 'RIPPERS.Sheet.Use'}}</button>{{/if}}
										<button type="button" class="rs-chip" data-action="itemSheet" data-item="{{it.id}}" title="{{localize 'RIPPERS.Sheet.OpenItem'}}">⚙</button>
										<button type="button" class="rs-chip rs-chip-danger" data-action="itemDelete" data-item="{{it.id}}" title="{{localize 'RIPPERS.Sheet.ItemDelete'}}">✕</button>
									</span>
								</div>
							{{/each}}
						</div>
					{{/if}}
				{{/each}}
				{{#unless vm.inventory.any}}<p class="rs-empty">{{localize 'RIPPERS.Sheet.NoInventory'}}</p>{{/unless}}
			{{/if}}

			{{#if vm.tab.effects}}
				{{!-- v0.7.15: native Active Effects — surfaces item/guise-transferred effects too, so a guise
				     PASSIVE shows here as an active passive (P5b passive-verification). Native FU/Foundry AE API. --}}
				{{#each vm.effects.groups as |grp|}}
					<div class="rs-fx-section">
						<div class="rs-fx-head">
							<span class="rs-inv-label">{{grp.label}}</span>
							<button type="button" class="rs-chip" data-action="effectCreate" data-effect-type="{{grp.createType}}">＋ {{localize 'RIPPERS.Sheet.EffectAdd'}}</button>
						</div>
						{{#if grp.effects.length}}
							{{#each grp.effects as |ef|}}
								<div class="rs-fx-row{{#if ef.disabled}} rs-fx-disabled{{/if}}">
									<img class="rs-inv-img" src="{{ef.img}}" alt="">
									<span class="rs-inv-name">{{ef.name}}</span>
									{{#if ef.source}}<span class="rs-fx-source">{{ef.source}}</span>{{/if}}
									<span class="rs-inv-controls">
										<button type="button" class="rs-chip" data-action="effectToggle" data-effect-id="{{ef.id}}">{{#if ef.disabled}}{{localize 'RIPPERS.Sheet.EffectEnable'}}{{else}}{{localize 'RIPPERS.Sheet.EffectDisable'}}{{/if}}</button>
										<button type="button" class="rs-chip" data-action="effectEdit" data-effect-id="{{ef.id}}" title="{{localize 'RIPPERS.Sheet.OpenItem'}}">⚙</button>
										<button type="button" class="rs-chip rs-chip-danger" data-action="effectDelete" data-effect-id="{{ef.id}}" title="{{localize 'RIPPERS.Sheet.ItemDelete'}}">✕</button>
									</span>
								</div>
							{{/each}}
						{{else}}<p class="rs-empty">—</p>{{/if}}
					</div>
				{{/each}}
			{{/if}}

			{{#if vm.tab.edit}}
				{{!-- Item 3 (headline): the character's OWN fields, two-way editable. Guise class/skill/affinity
				      locks live below (the guise builder), fixed at distillation. --}}
				<div class="rs-edit-block">
					<div class="rs-edit-title">{{localize 'RIPPERS.Sheet.EditCharacter'}}</div>
					<label class="rs-edit-row"><span>{{localize 'RIPPERS.Sheet.Name'}}</span><input type="text" data-edit="name" value="{{vm.editable.name}}"></label>
					<div class="rs-edit-grid">
						{{#each vm.editable.attributes as |a|}}
							<label class="rs-edit-row"><span>{{a.label}}</span>
								<select data-edit="system.attributes.{{a.key}}.base" data-dtype="number">
									{{#each a.options as |o|}}<option value="{{o.n}}" {{#if o.sel}}selected{{/if}}>d{{o.n}}</option>{{/each}}
								</select>
							</label>
						{{/each}}
					</div>
					<div class="rs-edit-grid">
						<label class="rs-edit-row"><span>HP</span><input type="number" data-edit="system.resources.hp.value" data-dtype="number" value="{{vm.editable.hp.value}}"></label>
						<label class="rs-edit-row"><span>HP max</span><input type="number" data-edit="system.resources.hp.max" data-dtype="number" value="{{vm.editable.hp.max}}"></label>
						<label class="rs-edit-row"><span>MP</span><input type="number" data-edit="system.resources.mp.value" data-dtype="number" value="{{vm.editable.mp.value}}"></label>
						<label class="rs-edit-row"><span>MP max</span><input type="number" data-edit="system.resources.mp.max" data-dtype="number" value="{{vm.editable.mp.max}}"></label>
						<label class="rs-edit-row"><span>IP</span><input type="number" data-edit="system.resources.ip.value" data-dtype="number" value="{{vm.editable.ip.value}}"></label>
						<label class="rs-edit-row"><span>IP max</span><input type="number" data-edit="system.resources.ip.max" data-dtype="number" value="{{vm.editable.ip.max}}"></label>
						<label class="rs-edit-row"><span>FP</span><input type="number" data-edit="system.resources.fp.value" data-dtype="number" value="{{vm.editable.fp}}"></label>
						<label class="rs-edit-row"><span>EXP</span><input type="number" data-edit="system.resources.exp.value" data-dtype="number" value="{{vm.editable.exp}}"></label>
						<label class="rs-edit-row"><span>Zenit</span><input type="number" data-edit="system.resources.zenit.value" data-dtype="number" value="{{vm.editable.zenit}}"></label>
					</div>
					<div class="rs-edit-title">{{localize 'RIPPERS.Sheet.EditBonds'}}</div>
					{{#each vm.editable.bonds as |b|}}
						<div class="rs-edit-bond">
							<input type="text" placeholder="{{localize 'RIPPERS.Sheet.BondWith'}}" data-bond-index="{{b.i}}" data-bond-field="name" value="{{b.name}}">
							<select data-bond-index="{{b.i}}" data-bond-field="admInf">{{#each b.admInfOpts as |o|}}<option value="{{o.v}}" {{#if o.sel}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
							<select data-bond-index="{{b.i}}" data-bond-field="loyMis">{{#each b.loyMisOpts as |o|}}<option value="{{o.v}}" {{#if o.sel}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
							<select data-bond-index="{{b.i}}" data-bond-field="affHat">{{#each b.affHatOpts as |o|}}<option value="{{o.v}}" {{#if o.sel}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
							<span class="rs-bond-tier rdb-tier-tag rdb-tier-{{b.tier}}">{{b.tier}}</span>
							<span class="rs-edit-bond-str">{{localize 'RIPPERS.Sheet.Strength'}} {{b.strength}}</span>
							<button type="button" class="rs-btn rs-edit-bond-rm" data-action="bondRemove" data-bond-index="{{b.i}}" title="{{localize 'RIPPERS.Sheet.BondRemove'}}">✕</button>
						</div>
					{{/each}}
					<button class="rs-btn" data-action="bondAddRow">＋ {{localize 'RIPPERS.Sheet.BondAdd'}}</button>
				</div>

				{{#if vm.editor.has}}
					<div class="rs-mini">
						<div class="rs-mini-label">{{localize 'RIPPERS.Sheet.Editing'}}</div>
						<div class="rs-mini-body" style="color:var(--rs-bone);">{{vm.editor.guiseName}}{{#if vm.editor.bound}} — {{localize 'RIPPERS.Sheet.BoundLockNote'}}{{/if}}</div>
					</div>
					<button class="rs-heroic" data-action="openEditor" data-guise="{{vm.editor.guiseId}}" style="border:none;cursor:pointer;">
						<span class="rs-heroic-label">{{localize 'RIPPERS.Sheet.Editor'}}</span>
						<span class="rs-heroic-name">{{localize 'RIPPERS.Sheet.OpenBuilder'}}</span>
					</button>
					<div class="rs-mini rs-mini-bane">
						<div class="rs-mini-label">{{localize 'RIPPERS.Sheet.FixedAtDistillation'}}</div>
						<div class="rs-mini-body">{{localize 'RIPPERS.Sheet.FixedList'}} — {{#if vm.editor.overrideOn}}{{localize 'RIPPERS.Sheet.OverrideOn'}}{{else}}{{localize 'RIPPERS.Sheet.OverrideOff'}}{{/if}}</div>
						<div class="rs-mini-body">{{localize 'RIPPERS.Sheet.SLToggleNote'}}</div>
					</div>
				{{else}}
					<p class="rs-empty">{{localize 'RIPPERS.Sheet.NoGuiseToEdit'}}</p>
				{{/if}}
			{{/if}}

			{{#if vm.tab.other}}
				<p class="rs-empty">{{vm.tab.otherNote}}</p>
			{{/if}}
		</div>

		{{!-- ── Status floor ─────────────────────────────────────── --}}
		<div class="rs-floor">
			<div class="rs-floor-row">
				<span class="rs-floor-label">{{localize 'RIPPERS.Sheet.Status'}}</span>
				{{#each vm.statusChips as |s|}}
					<button class="rs-chip {{#if s.active}}rs-chip-on{{/if}}" data-action="toggleStatus" data-status="{{s.id}}">{{s.label}}</button>
				{{/each}}
				<button class="rs-chip rs-chip-more {{#if vm.showConditions}}rs-chip-on{{/if}}" data-action="toggleConditions">{{localize 'RIPPERS.Sheet.AllConditions'}}</button>
				<button class="rs-chip rs-chip-more" data-action="openConditions" title="{{localize 'RIPPERS.Sheet.AfflictHint'}}">{{localize 'RIPPERS.Sheet.Afflict'}}</button>
				<span class="rs-mode">
					<button class="{{#if vm.statusSelf}}rs-mode-on{{/if}}" data-action="statusMode" data-mode="self">{{localize 'RIPPERS.Sheet.Self'}}</button>
					<button class="{{#unless vm.statusSelf}}rs-mode-on{{/unless}}" data-action="statusMode" data-mode="target">{{localize 'RIPPERS.Sheet.Target'}}</button>
				</span>
			</div>
			{{#if vm.showConditions}}
				<div class="rs-cond-tray">
					{{#each vm.condGroups as |grp|}}
						<div class="rs-cond-group">
							<span class="rs-cond-glabel">{{grp.label}}</span>
							<span class="rs-cond-items">{{#each grp.items as |c|}}<button class="rs-chip {{#if c.active}}rs-chip-on{{/if}}" data-action="toggleStatus" data-status="{{c.id}}">{{c.label}}</button>{{/each}}</span>
						</div>
					{{/each}}
				</div>
			{{/if}}
		</div>

		<div class="rs-foot-note">{{localize 'RIPPERS.Sheet.ReadOnlyNote'}}</div>
	</div>
</div>
