<div class="guise-builder-body">
	{{! GUISE-BUILDER-FIX v0.7.0 — 6-step wizard. Guardrails: exactly 3 classes, the affinity TRIO
	    (1 Immunity + 1 Vulnerability + 1 Resistance, never Absorption), per-guise ≤1 Immunity. Two
	    modes (Q1): a WORN mask (equipment / perk / bonus / tell / bane / flaw / affinities) and the
	    INNATE Guise (two Specialties + the creation Heroic; no armor/hands/affinities/perk/tell). }}

	<nav class="gb-progress" aria-label="{{localize "RIPPERS.Builder.Steps"}}">
		{{#each steps}}
			<span class="gb-step{{#if active}} is-active{{/if}}{{#if done}} is-done{{/if}}">
				<span class="gb-step-n">{{n}}</span><span class="gb-step-label">{{label}}</span>
			</span>
		{{/each}}
	</nav>
	<div class="gb-stepline">{{localize "RIPPERS.Builder.Step"}} {{step}} / {{stepTotal}}</div>

	<div class="gb-scroll">

		{{#if stepIdentity}}
			<fieldset class="gb-mode">
				<legend>{{localize "RIPPERS.Builder.Mode"}}</legend>
				<label class="gb-mode-opt"><input type="radio" class="guise-mode" name="guise-mode" value="worn" {{#if isWorn}}checked{{/if}} /> {{localize "RIPPERS.Builder.ModeWorn"}}</label>
				<label class="gb-mode-opt"><input type="radio" class="guise-mode" name="guise-mode" value="innate" {{#if isInnate}}checked{{/if}} /> {{localize "RIPPERS.Builder.ModeInnate"}}</label>
				<p class="gb-hint">{{#if isInnate}}{{localize "RIPPERS.Builder.ModeInnateHint"}}{{else}}{{localize "RIPPERS.Builder.ModeWornHint"}}{{/if}}</p>
			</fieldset>
			<fieldset class="gb-identity">
				<legend>{{localize "RIPPERS.Builder.Identity"}}</legend>
				<label>{{localize "RIPPERS.Builder.Name"}} <input type="text" data-draft="name" value="{{draft.name}}" /></label>
				<label>{{localize "RIPPERS.Builder.Role"}} <input type="text" data-draft="role" value="{{draft.role}}" /></label>
				{{#if isWorn}}<label>{{localize "RIPPERS.Builder.Nature"}} <input type="text" data-draft="nature" value="{{draft.nature}}" placeholder="{{localize "RIPPERS.Builder.NatureHint"}}" /></label>{{/if}}
				<label class="gb-img-field">{{localize "RIPPERS.Builder.Icon"}}
					<span class="gb-img-row">
						<img class="gb-img-preview" src="{{#if draft.img}}{{draft.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" width="40" height="40" alt="" />
						<input type="text" data-draft="img" value="{{draft.img}}" placeholder="path/to/sprite.webp" />
						<button type="button" class="gb-img-pick" data-action="pickImg" data-tooltip="{{localize "RIPPERS.Builder.PickImg"}}"><i class="fas fa-file-image"></i></button>
					</span>
				</label>
				<label>{{localize "RIPPERS.Builder.Color"}} <input type="color" data-draft="color" value="{{#if draft.color}}{{draft.color}}{{else}}#7b2d8e{{/if}}" /></label>
				<label class="gb-notes">{{localize "RIPPERS.Builder.Notes"}} <textarea data-draft="notes" rows="2">{{draft.notes}}</textarea></label>
			</fieldset>
		{{/if}}

		{{#if stepClasses}}
			<fieldset class="gb-classes" data-gb-fixed {{#if isEditing}}title="{{localize 'RIPPERS.Builder.FixedHint'}}"{{/if}}>
				<legend>{{localize "RIPPERS.Builder.Classes"}} — {{localize "RIPPERS.Builder.Exactly3"}}</legend>
				{{#each slots}}
					<select class="guise-class-slot" data-slot="{{i}}">
						{{#each options}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
					</select>
				{{/each}}
			</fieldset>
		{{/if}}

		{{#if stepSkills}}
			{{#each classBlocks}}
				<fieldset class="gb-skills">
					<legend>{{name}} — {{localize "RIPPERS.Builder.Skills"}}</legend>
					{{#each skills}}
						<div class="gb-skill">
							<label class="gb-skill-name"><input type="checkbox" class="guise-skill-check" data-key="{{key}}" {{#if checked}}checked{{/if}} /> {{name}}</label>
							<input type="number" class="guise-skill-sl" data-key="{{key}}" value="{{sl}}" min="0" max="{{maxSl}}" title="Max SL {{maxSl}}" />
							<span class="gb-maxsl">/ {{maxSl}}</span>
						</div>
					{{else}}
						<p class="gb-empty">{{localize "RIPPERS.Builder.NoSkills"}}</p>
					{{/each}}
				</fieldset>
			{{else}}
				<p class="gb-empty">{{localize "RIPPERS.Builder.PickClassFirst"}}</p>
			{{/each}}
			<div class="gb-budget">{{localize "RIPPERS.Builder.Budget"}}: <strong>{{spent}} / {{budget}}</strong> SL</div>
		{{/if}}

		{{#if stepLoadout}}
			{{#if isInnate}}
				<fieldset class="gb-specialties">
					<legend>{{localize "RIPPERS.Builder.Specialties"}} — {{loadout.specialtyCount}} / {{loadout.specialtyMax}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.SpecialtiesHint"}}</p>
					<label class="gb-talented"><input type="checkbox" class="guise-talented" {{#if loadout.talented}}checked{{/if}} /> {{localize "RIPPERS.Builder.Talented"}}</label>
					<div class="gb-specialty-inputs">
						{{#each loadout.specialtyInputs}}
							<label class="gb-specialty-input">{{label}}
								<input type="text" class="guise-specialty" data-i="{{i}}" value="{{value}}"
									   list="gb-specialty-hints" placeholder="{{../loadout.specialtyPlaceholder}}" />
							</label>
						{{/each}}
					</div>
					<datalist id="gb-specialty-hints">
						{{#each loadout.specialtyHints}}<option value="{{this}}"></option>{{/each}}
					</datalist>
				</fieldset>
				<fieldset class="gb-heroic">
					<legend>{{localize "RIPPERS.Builder.InnateHeroic"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.InnateHeroicHint"}}</p>
					{{#if loadout.heroicName}}
						<div class="gb-chip"><i class="fas fa-star"></i> {{loadout.heroicName}} <a data-action="clearHeroic" title="{{localize "RIPPERS.Builder.Clear"}}"><i class="fas fa-times"></i></a></div>
					{{/if}}
					<div class="guise-drop gb-drop" data-guise-drop="heroic">{{localize "RIPPERS.Builder.DropHeroic"}}</div>
				</fieldset>
				<fieldset class="gb-hunter">
					<legend>{{localize "RIPPERS.Builder.HunterWeapon"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.HunterWeaponHint"}}</p>
					{{#if loadout.hunterName}}
						<div class="gb-chip"><i class="fas fa-gavel"></i> {{loadout.hunterName}} <a data-action="clearHunter" title="{{localize "RIPPERS.Builder.Clear"}}"><i class="fas fa-times"></i></a></div>
					{{/if}}
					<div class="guise-drop gb-drop" data-guise-drop="hunter">{{localize "RIPPERS.Builder.DropHunter"}}</div>
					<label class="gb-check"><input type="checkbox" class="guise-hw-bane" {{#if loadout.hunterIsBane}}checked{{/if}} /> {{localize "RIPPERS.Builder.HWBane"}}</label>
					<p class="gb-hint">{{localize "RIPPERS.Builder.HWBaneHint"}}</p>
					<label>{{localize "RIPPERS.Builder.HWMaterial"}}
						<input type="text" data-draft="hunterMaterial" list="gb-hw-materials" value="{{loadout.hunterMaterial}}" placeholder="{{localize "RIPPERS.Builder.HWMaterialHint"}}" />
						<datalist id="gb-hw-materials">{{#each loadout.hwMaterialSuggestions}}<option value="{{this}}"></option>{{/each}}</datalist>
					</label>
					<label>{{localize "RIPPERS.Builder.HWOrigin"}} <input type="text" data-draft="hunterOrigin" value="{{loadout.hunterOrigin}}" placeholder="{{localize "RIPPERS.Builder.HWOriginHint"}}" /></label>
				</fieldset>
				<fieldset class="gb-innate-equip">
					<legend>{{localize "RIPPERS.Builder.InnateEquipment"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.InnateEquipmentHint"}}</p>
					{{#if loadout.armorName}}
						<div class="gb-chip"><i class="fas fa-shield-halved"></i> {{loadout.armorName}} <a data-action="clearArmor" title="{{localize "RIPPERS.Builder.Clear"}}"><i class="fas fa-times"></i></a></div>
					{{/if}}
					<div class="guise-drop gb-drop" data-guise-drop="armor">{{localize "RIPPERS.Builder.DropArmor"}}</div>
					{{#if loadout.accessoryName}}
						<div class="gb-chip"><i class="fas fa-ring"></i> {{loadout.accessoryName}} <a data-action="clearAccessory" title="{{localize "RIPPERS.Builder.Clear"}}"><i class="fas fa-times"></i></a></div>
					{{/if}}
					<div class="guise-drop gb-drop" data-guise-drop="accessory">{{localize "RIPPERS.Builder.DropAccessory"}}</div>
				</fieldset>
			{{else}}
				<fieldset class="gb-equipment" data-gb-fixed {{#if isEditing}}title="{{localize 'RIPPERS.Builder.FixedHint'}}"{{/if}}>
					<legend>{{localize "RIPPERS.Builder.Equipment"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.EquipmentHint"}}</p>
					{{#each loadout.equipment}}
						<div class="gb-equip-row">
							<span class="gb-equip-name">{{name}}</span>
							<select class="guise-equip-slot" data-i="{{i}}">{{#each slots}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
							<a data-action="removeEquip" data-i="{{i}}" title="{{localize "RIPPERS.Builder.RemoveEquip"}}"><i class="fas fa-times"></i></a>
						</div>
					{{/each}}
					<div class="guise-drop gb-drop" data-guise-drop="equipment">{{localize "RIPPERS.Builder.DropEquip"}}</div>
				</fieldset>
				<fieldset class="gb-signature-heroic">
					<legend>{{localize "RIPPERS.Builder.SignatureHeroic"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.SignatureHeroicHint"}}</p>
					{{#if loadout.attachedHeroicName}}
						<div class="gb-chip"><i class="fas fa-star"></i> {{loadout.attachedHeroicName}} <a data-action="clearWornHeroic" title="{{localize "RIPPERS.Builder.Clear"}}"><i class="fas fa-times"></i></a></div>
					{{/if}}
					<div class="guise-drop gb-drop" data-guise-drop="wornHeroic">{{localize "RIPPERS.Builder.DropSignatureHeroic"}}</div>
				</fieldset>
				<fieldset class="gb-attached-effects">
					<legend>{{localize "RIPPERS.Builder.AttachedEffects"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.AttachedEffectsHint"}}</p>
					{{#each loadout.attachedEffects}}
						<div class="gb-equip-row">
							<span class="gb-equip-name">{{name}}</span>
							<a data-action="removeAttachedEffect" data-i="{{i}}" title="{{localize "RIPPERS.Builder.RemoveAttachedEffect"}}"><i class="fas fa-times"></i></a>
						</div>
					{{/each}}
					<div class="guise-drop gb-drop" data-guise-drop="attachedEffect">{{localize "RIPPERS.Builder.DropAttachedEffect"}}</div>
				</fieldset>
				<fieldset class="gb-traits">
					<legend>{{localize "RIPPERS.Builder.Traits"}}</legend>
					<label>{{localize "RIPPERS.Builder.Perk"}} <input type="text" data-draft="perk" value="{{loadout.perk}}" placeholder="{{localize "RIPPERS.Builder.PerkHint"}}" /></label>
					<label>{{localize "RIPPERS.Builder.Bonus"}} (+{{loadout.bonusValue}}) <input type="text" data-draft="bonusDescriptor" value="{{loadout.bonusDescriptor}}" placeholder="{{localize "RIPPERS.Builder.BonusHint"}}" /></label>
					<p class="gb-hint">{{localize "RIPPERS.Builder.BonusNote"}}</p>
					<label>{{localize "RIPPERS.Builder.Tell"}} <input type="text" data-draft="tell" value="{{loadout.tell}}" placeholder="{{localize "RIPPERS.Builder.TellHint"}}" /></label>
					<label>{{localize "RIPPERS.Builder.Bane"}} <input type="text" data-draft="bane" value="{{loadout.bane}}" placeholder="{{localize "RIPPERS.Builder.BaneHint"}}" /></label>
					<label>{{localize "RIPPERS.Builder.Flaw"}} <input type="text" data-draft="flaw" value="{{loadout.flaw}}" placeholder="{{localize "RIPPERS.Builder.FlawHint"}}" /></label>
				</fieldset>
			{{/if}}
		{{/if}}

		{{#if stepAffinities}}
			{{#if isInnate}}
				<fieldset class="gb-affinities">
					<legend>{{localize "RIPPERS.Builder.Affinities"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.AffInnateNone"}}</p>
				</fieldset>
			{{else}}
				<fieldset class="gb-affinities">
					<legend>{{localize "RIPPERS.Builder.Affinities"}} — {{localize "RIPPERS.Builder.Trio"}}</legend>
					<p class="gb-hint">{{localize "RIPPERS.Builder.TrioHint"}}</p>
					<label class="gb-trio-row"><span class="gb-trio-k gb-trio-imm">{{localize "RIPPERS.Builder.Immunity"}}</span>
						<select class="guise-trio" data-slot="immunity">{{#each trio.immunity}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
					</label>
					<label class="gb-trio-row"><span class="gb-trio-k gb-trio-vuln">{{localize "RIPPERS.Builder.Vulnerability"}}</span>
						<select class="guise-trio" data-slot="vulnerability">{{#each trio.vulnerability}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
					</label>
					<label class="gb-trio-row"><span class="gb-trio-k gb-trio-res">{{localize "RIPPERS.Builder.Resistance"}}</span>
						<select class="guise-trio" data-slot="resistance">{{#each trio.resistance}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
					</label>
					{{#unless trioValid}}<p class="gb-error"><i class="fas fa-triangle-exclamation"></i> {{trioReason}}</p>{{/unless}}
				</fieldset>
			{{/if}}
		{{/if}}

		{{#if stepReview}}
			<fieldset class="gb-review">
				<legend>{{localize "RIPPERS.Builder.Review"}} — {{review.modeLabel}}</legend>
				<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Icon"}}</span><span class="gb-review-v"><img class="gb-img-preview gb-review-thumb" src="{{#if review.img}}{{review.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" width="32" height="32" alt="" /></span></div>
				<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Name"}}</span><span class="gb-review-v">{{review.name}}</span></div>
				{{#if review.role}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Role"}}</span><span class="gb-review-v">{{review.role}}</span></div>{{/if}}
				{{#if review.nature}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Nature"}}</span><span class="gb-review-v">{{review.nature}}</span></div>{{/if}}

				<div class="gb-review-h">{{localize "RIPPERS.Builder.Classes"}}</div>
				{{#each review.classes}}
					<div class="gb-review-class"><strong>{{name}}</strong>
						{{#each skills}}<span class="gb-review-skill">{{name}} <em>SL{{sl}}</em></span>{{else}}<span class="gb-empty">{{localize "RIPPERS.Builder.NoSkillsPicked"}}</span>{{/each}}
					</div>
				{{else}}
					<div class="gb-empty">{{localize "RIPPERS.Builder.PickClassFirst"}}</div>
				{{/each}}

				{{#if review.specialties.length}}
					<div class="gb-review-h">{{localize "RIPPERS.Builder.Specialties"}}</div>
					<div class="gb-review-v">{{#each review.specialties}}<span class="gb-review-skill">{{this}}</span>{{/each}}</div>
				{{/if}}
				{{#if review.heroic}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.InnateHeroic"}}</span><span class="gb-review-v">{{review.heroic}}</span></div>{{/if}}
				{{#if review.hunterWeapon}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.HunterWeapon"}}</span><span class="gb-review-v">{{review.hunterWeapon.name}}{{#if review.hunterWeapon.material}} · {{review.hunterWeapon.material}}{{/if}}{{#if review.hunterWeapon.origin}} · {{review.hunterWeapon.origin}}{{/if}}</span></div>{{/if}}

				{{#if isWorn}}
					{{#if review.equipment.length}}
						<div class="gb-review-h">{{localize "RIPPERS.Builder.Equipment"}}</div>
						{{#each review.equipment}}<div class="gb-review-row"><span class="gb-review-k">{{slot}}</span><span class="gb-review-v">{{name}}</span></div>{{/each}}
					{{/if}}
					<div class="gb-review-h">{{localize "RIPPERS.Builder.Affinities"}}</div>
					{{#if review.affinities.length}}<div class="gb-review-v">{{#each review.affinities}}<span class="gb-review-aff">{{this}}</span>{{/each}}</div>{{else}}<div class="gb-empty">{{localize "RIPPERS.Builder.AffNoneReview"}}</div>{{/if}}
					{{#if review.perk}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Perk"}}</span><span class="gb-review-v">{{review.perk}}</span></div>{{/if}}
					{{#if review.bonus}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Bonus"}}</span><span class="gb-review-v">+3 to {{review.bonus}} ({{localize "RIPPERS.Builder.GMApplied"}})</span></div>{{/if}}
					{{#if review.tell}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Tell"}}</span><span class="gb-review-v">{{review.tell}}</span></div>{{/if}}
					{{#if review.bane}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Bane"}}</span><span class="gb-review-v">{{review.bane}}</span></div>{{/if}}
					{{#if review.flaw}}<div class="gb-review-row"><span class="gb-review-k">{{localize "RIPPERS.Builder.Flaw"}}</span><span class="gb-review-v">{{review.flaw}}</span></div>{{/if}}
				{{/if}}

				{{#if review.errors.length}}
					<div class="gb-review-h gb-error-h">{{localize "RIPPERS.Builder.FixFirst"}}</div>
					{{#each review.errors}}<p class="gb-error"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
				{{/if}}

				<div class="gb-budget">{{localize "RIPPERS.Builder.Budget"}}: <strong>{{review.spent}} / {{review.budget}}</strong> SL</div>
			</fieldset>
		{{/if}}

	</div>{{! /.gb-scroll }}

	{{! v0.7.6: surface THIS step's guardrail errors inline, and gate its Next button on them. }}
	{{#if stepErrors.length}}
		<div class="gb-step-errors">
			{{#each stepErrors}}<p class="gb-error"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
		</div>
	{{/if}}

	{{! #4 (v0.7.9): with the GM override on, validation is soft — show the same findings as warnings. }}
	{{#if editOverride}}
		<div class="gb-override-note"><i class="fas fa-unlock"></i> {{localize "RIPPERS.Builder.OverrideOn"}}</div>
		{{#each warnings}}<p class="gb-warn"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
	{{/if}}

	<footer class="gb-footer">
		{{#unless isFirst}}<button type="button" class="gb-nav-back" data-action="back"><i class="fas fa-arrow-left"></i> {{localize "RIPPERS.Builder.Back"}}</button>{{/unless}}
		<span class="gb-nav-spacer"></span>
		{{#if isLast}}
			{{#if isEditing}}
				<button type="button" data-action="create" {{#unless canCreate}}disabled{{/unless}}><i class="fas fa-floppy-disk"></i> {{localize "RIPPERS.Builder.Save"}}</button>
			{{else}}
				<button type="button" data-action="create" {{#unless canCreate}}disabled{{/unless}}><i class="fas fa-mask"></i> {{localize "RIPPERS.Builder.Create"}}</button>
				<button type="button" data-action="createBind" {{#unless canCreate}}disabled{{/unless}}><i class="fas fa-user-secret"></i> {{localize "RIPPERS.Builder.CreateBind"}}</button>
			{{/if}}
		{{else}}
			<button type="button" class="gb-nav-next" data-action="next" {{#unless stepValid}}disabled{{/unless}}>{{localize "RIPPERS.Builder.Next"}} <i class="fas fa-arrow-right"></i></button>
		{{/if}}
	</footer>
</div>
