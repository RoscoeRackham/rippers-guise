{{!-- guise-readout.hbs — the guise play readout, shared by The Guise play surface and the
     Guises-tab read-only preview. Context: play=<play VM>, masthead=<masthead VM>, readonly=<bool>.
     readonly=true suppresses the mutating affordances (preview picker, Attack, clear-heroic, drop)
     so a non-worn guise can be inspected without touching it. NO second renderer. --}}
{{!-- 2. CHARACTER SUMMARY STRIP — level/torment meta + the dice (▲/▼ = guise mods). --}}
<div class="rs-play-strip">
	<div class="rs-play-who">
		<span class="rs-play-meta">LEVEL {{masthead.level}} · TORMENT — {{#if play.torment}}{{play.torment}}{{else}}<span class="rs-warn">⚠</span>{{/if}}</span>
	</div>
	<div class="rs-play-dice">
		{{#each play.attributes as |a|}}
			<span class="rs-die rs-die-{{a.shape}}{{#if a.buffed}} rs-die-up{{/if}}{{#if a.debuffed}} rs-die-down{{/if}}"><span class="rs-die-box"><span class="rs-die-glyph"></span>{{#if a.buffed}}<span class="rs-die-mark">▲</span>{{/if}}{{#if a.debuffed}}<span class="rs-die-mark">▼</span>{{/if}}<span class="rs-die-val">d{{a.die}}</span></span><span class="rs-die-lbl">{{a.label}}</span></span>
		{{/each}}
	</div>
</div>
{{!-- 3. guise title + PREVIEW dropdown (player-visible; previews a readout only, no Swap, no Turn) --}}
<div class="rs-play-head">
	<div class="rs-play-title">{{play.guiseName}}{{#if play.preview}} <span class="rs-play-previewing">PREVIEW</span>{{/if}}</div>
	{{#unless readonly}}
	<div class="rs-play-preview">
		<span class="rs-play-preview-k">PREVIEW — LOOK ONLY</span>
		<select data-preview-guise title="Preview another guise's readout — this does NOT change your guise. Use Swap (top-right) to change.">
			<option value="">{{play.activeName}} — BOUND</option>
			{{#each play.guiseMenu as |g|}}{{#unless g.worn}}<option value="{{g.id}}"{{#if g.previewing}} selected{{/if}}>{{g.name}}</option>{{/unless}}{{/each}}
		</select>
	</div>
	{{/unless}}
</div>
{{!-- 4. classes as cards; each skill row click-to-expand full rule text + source tag --}}
<div class="rs-play-classes">
	{{#each play.classes as |c|}}
		{{#if c.unauthored}}
			<div class="rs-play-class rs-dashed"><div class="rs-play-class-name rs-warn">CLASS SLOT — ⚠ NOT SET YET</div></div>
		{{else}}
			<div class="rs-play-class">
				<div class="rs-play-class-name">{{c.name}}</div>
				{{#if c.hasSubNote}}<div class="rs-play-subnote">{{c.subNote}}</div>{{/if}}
				{{#each c.skills as |sk|}}
					<details class="rs-play-skill">
						<summary><span class="rs-play-skill-name">{{sk.name}}</span><span class="rs-play-skill-sl">SL {{sk.sl}}/{{sk.maxSl}} <span class="rs-play-caret">▸</span></span></summary>
						{{#if sk.hasDesc}}<div class="rs-play-skill-desc">{{{sk.desc}}}</div>{{else}}<div class="rs-play-gap">{{localize 'RIPPERS.Sheet.NoSkillDesc'}}</div>{{/if}}
						{{#if sk.hasSource}}<div class="rs-play-source">{{sk.source}}</div>{{/if}}
					</details>
				{{/each}}
			</div>
		{{/if}}
	{{/each}}
</div>
{{!-- 5. heroic row — three slots; click to expand rules + requirements; empty = dashed --}}
<div class="rs-play-heroics">
	{{#each play.heroicSlots as |h|}}
		{{#if h.filled}}
			<details class="rs-play-heroic-slot">
				<summary class="rs-play-heroic"><span class="rs-play-heroic-k">{{localize 'RIPPERS.Sheet.Heroic'}}</span> {{h.name}}</summary>
				{{#if h.hasReq}}<div class="rs-play-heroic-req">REQ — {{h.req}}</div>{{/if}}
				{{#if h.hasDesc}}<div class="rs-play-skill-desc">{{{h.desc}}}</div>{{/if}}
			</details>
		{{else if h.locked}}
			<div class="rs-play-heroic-empty rs-locked">HEROIC SLOT — LOCKED · MASTER {{h.needMastered}} CLASSES</div>
		{{else}}
			<div class="rs-play-heroic-empty rs-dashed">HEROIC SLOT — EMPTY</div>
		{{/if}}
	{{/each}}
</div>
{{!-- 5b. CHARACTER HEROICS — two, unlocked at character L40/L50; character-level, cross-guise --}}
<div class="rs-play-charheroics">
	<div class="rs-play-charheroics-k">{{localize 'RIPPERS.Sheet.CharacterHeroics'}}</div>
	{{#each play.characterHeroics as |c|}}
		{{#if c.unlocked}}
			{{#if c.filled}}
				<details class="rs-play-heroic-slot">
					<summary class="rs-play-heroic"><span class="rs-play-heroic-k">L{{c.gate}}</span> {{c.name}}{{#unless ../readonly}} <a data-action="clearCharacterHeroic" data-slot="{{c.slot}}" title="{{localize 'RIPPERS.Builder.Clear'}}">✕</a>{{/unless}}</summary>
					{{#if c.hasDesc}}<div class="rs-play-skill-desc">{{{c.desc}}}</div>{{/if}}
				</details>
			{{else}}
				{{#if ../readonly}}
					<div class="rs-play-heroic-empty rs-dashed">L{{c.gate}} — EMPTY</div>
				{{else}}
					<div class="rs-play-heroic-empty rs-dashed" data-charheroic-drop="{{c.slot}}">L{{c.gate}} — {{localize 'RIPPERS.Sheet.DragHeroic'}}</div>
				{{/if}}
			{{/if}}
		{{else}}
			<div class="rs-play-heroic-empty rs-locked">{{localize 'RIPPERS.Sheet.HeroicLocked'}} L{{c.gate}}</div>
		{{/if}}
	{{/each}}
</div>
{{!-- 6. WHAT THIS GUISE CHANGES + ARMOR (WORN) side by side --}}
<div class="rs-play-cols">
	<div class="rs-play-changes">
		<div class="rs-play-sec-k">WHAT THIS GUISE CHANGES</div>
		{{#if play.changes.length}}<div class="rs-play-chips">{{#each play.changes as |m|}}<span class="rs-play-chip rs-chip-{{m.kind}}">{{m.label}}{{#if m.note}} <i>{{m.note}}</i>{{/if}}</span>{{/each}}</div>{{else}}<div class="rs-play-gap">—</div>{{/if}}
	</div>
	<div class="rs-play-armorbox">
		<div class="rs-play-sec-k">ARMOR — WORN</div>
		{{!-- v0.7.31: ONE ROW (Austin) — name + MARTIAL + gold worn totals; no duplicated
		     formula fragments, no second line. Worn totals are the single readout. --}}
		<div class="rs-play-armor">{{#if play.armor}}<b>{{play.armor.name}}</b>{{#if play.armor.martial}} <span class="rs-play-martial">MARTIAL</span>{{/if}} · {{/if}}<span class="rs-play-worn">DEF {{play.wornDef}} · M.DEF {{play.wornMdef}}</span></div>
	</div>
</div>
{{!-- 7. affinities — all NINE elements, four states --}}
<div class="rs-play-affs">{{#each play.affinities as |aff|}}<span class="rs-affchip rs-aff-{{aff.state}}">{{aff.type}} — {{aff.word}}</span>{{/each}}</div>
{{#if play.affinityTrioOwed}}<div class="rs-play-owed rs-warn">AFFINITIES — ⚠ NOT SET FOR THIS GUISE YET</div>{{else if play.innateNoTrio}}<div class="rs-play-owed rs-play-note">{{localize 'RIPPERS.Sheet.InnateNoTrio'}}</div>{{/if}}
{{!-- 8. bane / tell / perk cards (innate → NONE; unauthored → ⚠ OWED) --}}
<div class="rs-play-btp">
	{{#if play.innate}}
		<div class="rs-play-card"><span class="rs-play-card-k">{{localize 'RIPPERS.Builder.Bane'}}</span> NONE — INNATE</div>
	{{else}}
		<div class="rs-play-card rs-play-bane"><span class="rs-play-card-k">{{localize 'RIPPERS.Builder.Bane'}}</span> {{#if play.bane}}{{play.bane}}{{else}}<span class="rs-warn">⚠ NOT SET YET</span>{{/if}}</div>
		<div class="rs-play-card"><span class="rs-play-card-k">{{localize 'RIPPERS.Builder.Tell'}}</span> {{#if play.tell}}{{play.tell}}{{else}}<span class="rs-warn">⚠ NOT SET YET</span>{{/if}}</div>
		<div class="rs-play-card"><span class="rs-play-card-k">{{localize 'RIPPERS.Builder.Perk'}}</span> {{#if play.perk}}{{play.perk}}{{else}}<span class="rs-warn">⚠ NOT SET YET</span>{{/if}}</div>
	{{/if}}
	{{#if play.bonus}}<div class="rs-play-card"><span class="rs-play-card-k">{{localize 'RIPPERS.Builder.Bonus'}}</span> +{{play.bonus.value}} to {{play.bonus.descriptor}}</div>{{/if}}
</div>
{{!-- 9. weapon detail + equipped (fixed at distillation) + clot --}}
{{#if play.weapon}}<div class="rs-play-weapon"><b>{{play.weapon.name}}</b> · {{play.weapon.accLabel}} · {{play.weapon.dmgLabel}} {{play.weapon.dmgType}}{{#if play.weapon.traits.length}} · {{#each play.weapon.traits as |t|}}{{t}} {{/each}}{{/if}}{{#unless readonly}}{{#if play.weapon.id}} <button type="button" class="rs-chip rs-play-attack" data-action="rollWeapon" data-item="{{play.weapon.id}}">{{localize 'RIPPERS.Sheet.Attack'}}</button>{{/if}}{{/unless}}</div>{{/if}}
<div class="rs-play-equip"><span class="rs-inv-label">{{localize 'RIPPERS.Sheet.Equipped'}} — FIXED AT DISTILLATION</span>{{#if play.equipment.length}}{{#each play.equipment as |e|}}<span class="rs-play-equip-item"><img src="{{e.img}}" alt="">{{e.name}}</span>{{/each}}{{else}}<span class="rs-play-gap">—</span>{{/if}}</div>
<div class="rs-play-sec-k">CLOT</div>
<div class="rs-play-clot">{{#if play.clot.seated}}{{#each play.clot.clots as |cl|}}<div class="rs-play-clot-row"><span class="rs-play-clot-name">{{cl.name}}</span>{{#if cl.hasEffect}}<span class="rs-play-clot-fx">{{{cl.effect}}}</span>{{else}}<span class="rs-play-clot-fx rs-play-gap">—</span>{{/if}}</div>{{/each}}{{else}}<span class="rs-play-gap">No Clot seated.</span>{{/if}}</div>
{{!-- 10. identity footer — BOUND/TRADABLE, field limit, the Turn --}}
<div class="rs-play-footer">
	{{#if play.tradable}}<span class="rs-tag-trade">THE PHIAL — TRADABLE</span> <span class="rs-play-turn">travels whole; bind resets on hand-off</span>{{else}}<span class="rs-tag-bound">BOUND — UNTRADABLE</span>{{/if}}
	<span class="rs-play-field">{{localize 'RIPPERS.Sheet.FieldLimit'}}: {{play.fieldLimit}}</span>
	<span class="rs-play-turn">{{localize 'RIPPERS.Sheet.TheTurnNote'}}</span>
</div>
